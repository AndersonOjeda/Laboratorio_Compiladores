// ✅ TEST 1: Declaraciones y asignaciones válidas
// Debe aceptar enteros y concatenación de cadenas
int x = 10;
string s = "hola";
x = x + 5;
s = s + " mundo";

// ✅ TEST 7: If con else y scope
// Variables reutilizadas en diferentes scopes
int y = 0;
if (y < 5) {
  int z = 10;
} else {
  int z = 20;
}

// ✅ TEST 8: Anidamiento de while + if
// Valida scopes anidados y reutilización de variables
int i = 0;
while (i < 3) {
  int j = 0;
  while (j < 2) {
    if (i == j) {
      j = j + 1;
    }
    j = j + 1;
  }
  i = i + 1;
}

// ✅ TEST 9: Uso de continue y break en diferentes contextos
int contador = 0;
while (contador < 5) {
  if (contador == 2) {
    continue;
  }
  if (contador == 4) {
    break;
  }
  contador = contador + 1;
}

// ✅ ADICIONAL: Operación válida con strings (concatenación)
string a = "hola";
string b = " mundo";
string c = a + b;

// ✅ ADICIONAL: Expresiones complejas anidadas con operadores
int p = 5;
int q = 3;
int r = (p + q) * 2 - 1;

// ✅ ADICIONAL: Comparaciones válidas en condiciones
int num1 = 10;
int num2 = 20;
if (num1 < num2) {
  int diff = num2 - num1;
}

// ✅ ADICIONAL: While con comparación válida
int counter = 0;
while (counter <= 10) {
  if (counter >= 5) {
    break;
  }
  counter = counter + 1;
}
